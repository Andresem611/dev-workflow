{
  "name": "dev-pipeline-frontend",
  "description": "Frontend development pipeline v4.5.0 — decision + requirement binding (verify-requirements-coverage, Phase Boundary Aggregation, MANIFEST Dependencies typed, bridge Requirements Coverage section), decision fidelity enforcement, visual QA, behavior-slice tasks, design mockup gates",
  "version": "4.5.0",
  "author": {
    "name": "Thoven",
    "email": "andres@thoven.co"
  },
  "license": "MIT",
  "keywords": ["development", "pipeline", "frontend", "skills"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/doc-staleness-nudge.js"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/session-context.js"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/check-update.js"
          }
        ]
      }
    ]
  }
}
