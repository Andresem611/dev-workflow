{
  "name": "dev-pipeline-frontend",
  "description": "Frontend development pipeline v4.3.0 — decision fidelity enforcement (verify-decision-coverage, two-tier LOCKED decisions, verbatim echo-back), visual QA, behavior-slice tasks, design mockup gates",
  "version": "4.3.0",
  "author": {
    "name": "Thoven",
    "email": "andres@thoven.co"
  },
  "license": "MIT",
  "keywords": ["development", "pipeline", "frontend", "skills"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/doc-staleness-nudge.js"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/session-context.js"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/check-update.js"
          }
        ]
      }
    ]
  }
}
