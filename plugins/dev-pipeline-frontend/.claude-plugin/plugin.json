{
  "name": "dev-pipeline-frontend",
  "description": "Frontend development pipeline v2.0 — 4-stage inner loop (Discuss → Architect → Execute → Review) for phased feature delivery from intake through ship",
  "version": "2.2.0",
  "author": {
    "name": "Thoven",
    "email": "andres@thoven.co"
  },
  "license": "MIT",
  "keywords": ["development", "pipeline", "frontend", "skills"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/doc-staleness-nudge.js"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/session-context.js"
          }
        ]
      }
    ]
  }
}
