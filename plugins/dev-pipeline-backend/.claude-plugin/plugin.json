{
  "name": "dev-pipeline-backend",
  "description": "Backend development pipeline v3.5.0 — runtime API verification via Playwright, behavior-slice tasks, inner loop visual tracking via TaskCreate, multi-domain agent routing",
  "version": "3.5.0",
  "author": {
    "name": "Thoven",
    "email": "andres@thoven.co"
  },
  "license": "MIT",
  "keywords": ["development", "pipeline", "backend", "rails", "skills"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/doc-staleness-nudge.js"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/session-context.js"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/check-update.js"
          }
        ]
      }
    ]
  }
}
